# Credentials for pangolin-push.py
# Copy to scripts/.env and fill in real values. scripts/.env is gitignored.

# === Required ===

# Base URL of the Pangolin API (note: api.<host>, not the admin UI host).
# For PIA: https://api.bnkserve.org/v1
PANGOLIN_API_BASE=

# Bearer token. Pangolin admin → Organization → API Keys → Create.
# Permissions: list resources, list sites, list domains, create resource, create target.
PANGOLIN_API_KEY=

# === Optional — auto-discovered if there's only one ===

# Org slug, e.g. 'public-interest-alberta'. If unset, the script picks the only
# org the API key can see; if it sees more than one, you must set this.
PANGOLIN_ORG_ID=

# Default site name or niceId for `pangolin-push <sub> <ip>:<port>` (no --site).
# Run `python3 scripts/pangolin-push.py --list` to see options.
PANGOLIN_DEFAULT_SITE=

# Default base domain (e.g. publicinterestalberta.org) for the create-resource step.
PANGOLIN_DEFAULT_DOMAIN=
